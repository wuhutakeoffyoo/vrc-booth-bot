# NoneBot / OneBot v11
DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
# NapCat 反向 WS 的 access_token（与 NapCat 侧配置一致，必填以防公网裸奔）
ONEBOT_ACCESS_TOKEN=
# SUPERUSERS='["10000"]'

# booth CLI：默认从 PATH 找 booth；也可指向 booth.py 绝对路径
BOOTH_CLI_PATH=

# AI 后端：api=OpenAI 兼容 HTTP（默认，走 OpenCode Zen Go 套餐端点）| cli=本机 opencode CLI
AI_MODE=api
AI_CLI_BIN=/home/ubuntu/.opencode/bin/opencode
AI_CLI_MODEL=opencode/mimo-v2.6-flash-free
AI_CLI_TIMEOUT=90

# api 模式参数：Go 套餐端点为 https://opencode.ai/zen/go/v1（模型走套餐额度，
# 需 x-opencode-session 头，代码自动带上）；GLM 直连用 https://open.bigmodel.cn/api/paas/v4
VISION_API_KEY=
VISION_BASE_URL=https://opencode.ai/zen/go/v1
VISION_MODEL=glm-5.3-flash
VISION_SESSION_ID=
VISION_TIMEOUT=60

# 兜底 api：主 api（Go 套餐）失败/额度耗尽时自动切换（GLM Coding Plan 等 OpenAI 兼容端点）
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
AI_FALLBACK_MODEL=glm-5.3-flash
# 自我纠错：利用模型 VRChat 圈知识回忆知名商品名（中文查询时追加搜索）
RECALL_ENABLED=true
# 网络检索兜底：站内搜索无果时从 DDG/Exa 找 booth.pm 商品链接（Exa 需 key，可选）
WEBSEARCH_FALLBACK=true
EXA_API_KEY=

# 搜索行为
BOOTH_LIMIT=6
BOOTH_SORT=popularity
R18_MODE=include
IMGSEARCH_HEADLESS=true
IMGSEARCH_TIMEOUT=240
SEARCH_TIMEOUT=60

# 访问控制（JSON 数组格式；群号/QQ号兼容数字与字符串）
# 群白名单：非空则仅这些群响应（白名单外静默忽略）；留空 = 不限制群
GROUP_WHITELIST='["100000001","200000002"]'
# 管理员 QQ：可用敏感指令 /vrc r18（R-18 专项搜索），且私聊始终可用
ADMIN_USERS='["300000003","400000004"]'
# 非管理员私聊是否可用（false = 私聊仅管理员）
ALLOW_PRIVATE=true
# 搜索结果以 QQ 合并转发发送（每条附商品图）；false = 纯文本
FORWARD_MESSAGES=true
# VRC 对口：关键词搜索自动附加 --tag VRChat 收窄到 VRChat 商品圈；置空关闭
VRC_TAG=VRChat
# bot 侧限速：同一用户两次搜索最小间隔（秒）与每分钟次数上限（防刷指令触发风控）
USER_COOLDOWN=10
USER_RATE_LIMIT=5
# 查询结果缓存：相同查询 TTL 内直接返回缓存（省 AI 额度）；容量超限自动清理最旧
QUERY_CACHE_TTL=1800
QUERY_CACHE_MAX=300
