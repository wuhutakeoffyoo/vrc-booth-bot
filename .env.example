# NoneBot / OneBot v11
DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
# NapCat 反向 WS 的 access_token（与 NapCat 侧配置一致，必填以防公网裸奔）
ONEBOT_ACCESS_TOKEN=
# SUPERUSERS='["10000"]'

# booth CLI：默认从 PATH 找 booth；也可指向 booth.py 绝对路径
BOOTH_CLI_PATH=

# AI 后端：cli=本机 opencode CLI（默认，Go 套餐 free 模型可用）| api=OpenAI 兼容 HTTP
AI_MODE=cli
AI_CLI_BIN=/home/ubuntu/.opencode/bin/opencode
AI_CLI_MODEL=opencode/mimo-v2.6-flash-free
AI_CLI_TIMEOUT=90

# api 模式参数（OpenCode Zen / 智谱 GLM 直连等 OpenAI 兼容端点）
# 注意：api 模式留空 VISION_API_KEY 且 cli 不可用时，AI 功能整体关闭（优雅退化）
VISION_API_KEY=
VISION_BASE_URL=https://opencode.ai/zen/v1
VISION_MODEL=glm-5.3-flash
VISION_TIMEOUT=60

# 搜索行为
BOOTH_LIMIT=6
BOOTH_SORT=popularity
R18_MODE=include
IMGSEARCH_HEADLESS=true
IMGSEARCH_TIMEOUT=240
SEARCH_TIMEOUT=60

# 访问控制（JSON 数组格式；群号/QQ号兼容数字与字符串）
# 群白名单：非空则仅这些群响应（白名单外静默忽略）；留空 = 不限制群
GROUP_WHITELIST='["100000001","200000002"]'
# 管理员 QQ：可用敏感指令 /vrc r18（R-18 专项搜索），且私聊始终可用
ADMIN_USERS='["300000003","400000004"]'
# 非管理员私聊是否可用（false = 私聊仅管理员）
ALLOW_PRIVATE=true
