# NoneBot / OneBot v11
DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
# NapCat 反向 WS 的 access_token（与 NapCat 侧配置一致，必填以防公网裸奔）
ONEBOT_ACCESS_TOKEN=
# SUPERUSERS='["10000"]'

# booth CLI：默认从 PATH 找 booth；也可指向 booth.py 绝对路径
BOOTH_CLI_PATH=

# 默认工具模式，由已有工作流的当前 AI 规划/判断；有 key 也不会自动调用模型
# 独立 QQ Bot 要 AI 规划/识图时显式改为 api；cli 为显式旧文字模式
AI_MODE=caller
AI_CLI_BIN=
AI_CLI_MODEL=opencode/mimo-v2.6-flash-free
AI_CLI_TIMEOUT=90

# 填入你的 key 和 HTTPS API 根端点或完整调用端点；不在 URL 中放 key
# 支持 OpenAI 兼容 /chat/completions、Anthropic /messages、Gemini :generateContent
AI_API_KEY=
AI_BASE_URL=
# 空/auto：通过 /models 自动选择默认模型或声明支持图片的模型；接口无列表时补填
AI_MODEL=
# 兼容已有 VISION_API_KEY / VISION_BASE_URL / VISION_MODEL；新变量非空时优先
# 仅 api/cli 模式在启动/首次图片查询验证能力；caller 不探测、不处理图片
# 未通过、未配置或暂不可用时关闭所有图片入口
VISION_SESSION_ID=
VISION_TIMEOUT=60

# 可选兜底 API，同样只需 key + URL（模型列表不可用时填写模型）
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=
# 自我纠错：利用模型 VRChat 圈知识回忆知名商品名（中文查询时追加搜索）
RECALL_ENABLED=true
# 可选网页搜索：与 AI 分开配置，用户选择服务商；不预设搜索 URL
WEBSEARCH_FALLBACK=true
SEARCH_API_KEY=
SEARCH_BASE_URL=
# auto 识别官方域名，其余按通用 JSON；代理可选 json/exa/tavily/brave/searxng
SEARCH_PROVIDER=auto
SEARCH_DDG_ENABLED=true
# 以下仅兼容旧 Exa 用户；填了 SEARCH_BASE_URL 后不再使用旧连接
EXA_API_KEY=
# Exa 原生或兼容检索端点；与 AI_BASE_URL 分开，不把聊天接口当检索接口
EXA_BASE_URL=

# 搜索行为
BOOTH_LIMIT=6
BOOTH_SORT=popularity
R18_MODE=include
IMGSEARCH_HEADLESS=true
IMGSEARCH_TIMEOUT=240
# 图片来源使用 HTTPS 精确域名白名单；每次重定向重新检查，禁止内网及本地文件。
# 缺省含 QQ 官方图床与 Booth 图床；仅在需要时添加可信图床域名（JSON 数组）。
# IMAGE_ALLOWED_HOSTS='["multimedia.nt.qq.com.cn","gchat.qpic.cn","c2cpicdw.qpic.cn","booth.pximg.net","booth.pm"]'
SEARCH_TIMEOUT=60
QUERY_TIMEOUT=180
# 同机 CLI 共用请求许可；首轮 12，二轮明确扩展为总计 18（含重试/重定向/详情）
REQUEST_BUDGET=12
RETRY_REQUEST_BUDGET=18
# 保留同一搜索页的更多候选，不增加抓取页数
SEARCH_CANDIDATE_LIMIT=60
PLAN_CACHE_TTL=1800
# 盲测单独运行，默认禁止 AI；独立账号/配额确认后才允许
RUN_PROFILE=production
BENCHMARK_ALLOW_AI=false

# 访问控制（JSON 数组格式；群号/QQ号兼容数字与字符串）
# 群白名单：非空则仅这些群响应（白名单外静默忽略）；留空 = 不限制群
GROUP_WHITELIST='["100000001","200000002"]'
# 管理员 QQ：可用敏感指令 /vrc r18（R-18 专项搜索），且私聊始终可用
ADMIN_USERS='["300000003","400000004"]'
# 非管理员私聊是否可用（false = 私聊仅管理员）
ALLOW_PRIVATE=true
# 搜索结果以 QQ 合并转发发送（每条附商品图）；false = 纯文本
FORWARD_MESSAGES=true
# VRC 对口：关键词搜索自动附加 --tag VRChat 收窄到 VRChat 商品圈；置空关闭
VRC_TAG=VRChat
# bot 侧限速：同一用户两次搜索最小间隔（秒）与每分钟次数上限（防刷指令触发风控）
USER_COOLDOWN=10
USER_RATE_LIMIT=5
# 全局并发上限：同时处理的生产任务数；相同在途查询共享一个任务
GLOBAL_CONCURRENCY=2
# 查询结果缓存：相同查询 TTL 内直接返回缓存（省 AI 额度）；容量超限自动清理最旧
QUERY_CACHE_TTL=1800
QUERY_CACHE_MAX=300

# 关注清单（/vrc watch）：后台定时检查关注商品的价格/补货/更新并推送变动到群。
# 后台检查走 CLI 共享请求预算（每项 ≥1 秒限速）；推送目标留空则用群白名单
WATCH_ENABLED=false
WATCH_INTERVAL=3600
WATCH_NOTIFY_GROUPS='["100000001"]'
